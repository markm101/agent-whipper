# Three different random tokens, such as the output of: openssl rand -hex 24
# Agents use the agent token, runners the runner token, and you the admin
# token, which is also the dashboard's password.
WHIP_AGENT_TOKEN=
WHIP_RUNNER_TOKEN=
WHIP_ADMIN_TOKEN=

# Where whip-server listens on the host. Agents on this machine use
# http://127.0.0.1:8080. To reach it from other machines, put it behind a TLS
# proxy and bind 0.0.0.0.
WHIP_BIND=127.0.0.1
WHIP_PORT=8080

# Module time limits in minutes. Extensions come on top of the ceiling.
WHIP_DEFAULT_MAX_MINUTES=90
WHIP_MAX_MINUTES_CEILING=120

# The runner. Labels say what hardware it has (cpu, gpu). WHIP_REPO is the
# remote for projects that don't name one; WHIP_REPOS is a host folder of bare
# repos, mounted at /repos. WHIP_CPUSET pins benchmarks to cores, such as 2-5.
WHIP_RUNNER_NAME=runner-1
WHIP_LABELS=cpu
WHIP_REPO=
WHIP_REPOS=./repos
WHIP_CPUSET=
WHIP_MEMORY=
